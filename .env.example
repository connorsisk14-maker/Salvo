# Required runtime variables
SALVO_SECRETS_BACKEND=env
SALVO_WORKSPACE_ROOT=
SALVO_LOG_LEVEL=info
SALVO_LOG_TARGET=split
SALVO_SECRETS_FILE_PATH=
SALVO_SECRETS_KEYCHAIN_SERVICE_PREFIX=salvo
SALVO_SECRETS_KEYCHAIN_ACCOUNT=salvo
SALVO_API_IDEMPOTENCY_TTL_HOURS=24
SALVO_RECOVERY_ORPHAN_RUN_AFTER_SECONDS=30
SALVO_RECOVERY_ORPHAN_TASK_AFTER_SECONDS=120
SALVO_RECOVERY_MAX_RUN_ATTEMPTS=2
SALVO_BACKUP_DIR=
SALVO_BACKUP_HOUR_LOCAL=3
SALVO_BACKUP_RETENTION_DAILY=7
SALVO_BACKUP_RETENTION_WEEKLY=4
SALVO_BACKUP_STALE_AFTER_HOURS=36

# Optional local ports
SALVO_API_PORT=8787
SALVO_HEALTH_ORCHESTRATOR_STALE_SECONDS=15
SALVO_HEALTH_RESEARCH_STALE_SECONDS=45
SALVO_RESEARCH_MIN_SAMPLE_SIZE=15
SALVO_BACKUP_PG_DUMP_COMMAND=pg_dump
SALVO_BACKUP_PG_RESTORE_COMMAND=pg_restore

# Dashboard API URL (for apps/web)
VITE_SALVO_API_URL=http://localhost:8787

# Optional integration defaults (used by /integrations fallback when DB config is missing)
SALVO_LLM_PROVIDER=anthropic
SALVO_LLM_BASE_URL=
SALVO_LLM_DEFAULT_MODEL=

# Optional local bootstrap overrides
SALVO_LOCAL_DB_MODE=docker
SALVO_LOCAL_LLM_MODE=fake
SALVO_LOCAL_POSTGRES_CONTAINER=salvo-postgres
SALVO_LOCAL_POSTGRES_PORT=54329
SALVO_LOCAL_POSTGRES_USER=salvo
SALVO_LOCAL_POSTGRES_PASSWORD=salvo
SALVO_LOCAL_POSTGRES_DB=salvo_test
SALVO_FAKE_LLM_HOST=127.0.0.1
SALVO_FAKE_LLM_PORT=9797
SALVO_E2E_API_URL=http://localhost:8787

# Do not store plaintext secrets in .env.
# Provide secret values via your shell environment, encrypted file, or macOS keychain.
