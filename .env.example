# Required runtime variables
SALVO_DATABASE_URL=
SALVO_WORKSPACE_ROOT=
SALVO_API_TOKEN=
SALVO_LOG_LEVEL=info
SALVO_LOG_TARGET=split

# Optional local ports
SALVO_API_PORT=8787
SALVO_HEALTH_ORCHESTRATOR_STALE_SECONDS=15
SALVO_HEALTH_RESEARCH_STALE_SECONDS=45
SALVO_RESEARCH_MIN_SAMPLE_SIZE=15

# Dashboard API URL (for apps/web)
VITE_SALVO_API_URL=http://localhost:8787

# Optional integration defaults (used by /integrations fallback when DB config is missing)
SALVO_LLM_PROVIDER=anthropic
SALVO_LLM_API_KEY=
SALVO_LLM_BASE_URL=
SALVO_LLM_DEFAULT_MODEL=
